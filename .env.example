# Beehiiv publication the signup forms subscribe to.
# BEEHIIV_API_KEY is already expected in Vercel.
# BEEHIIV_PUBLICATION_ID is the publication id from Beehiiv (Settings → API, or the id in the publication URL).
# If either is missing, /api/subscribe returns a friendly error and does not save the email.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
