---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { gradeFilters, prompts, subjectFilters } from "../data/prompts";
---

<Base
  title="Prompt Library — AI Classroom Hub"
  description="25 grade-level mega-prompts for ChatGPT, Claude, and Gemini. Each one uses the RCTF structure — Role, Context, Task, Format — for classroom-ready output."
  path="/prompt-library"
>
  <section class="py-14 bg-[#2563EB] relative overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: repeating-linear-gradient(45deg, white 0, white 1px, transparent 0, transparent 50%); background-size: 20px 20px;"></div>
    <div class="container relative">
      <div class="max-w-3xl">
        <span class="text-xs font-bold font-display uppercase tracking-widest text-blue-200 mb-3 block">Prompt Library — 25 Mega-Prompts</span>
        <h1 class="text-4xl font-extrabold font-display text-white mb-4 leading-tight">Grade-level mega-prompts that save real time.</h1>
        <p class="text-lg text-blue-100 leading-relaxed mb-4">
          Teachers using AI across multiple categories save an average of 10–14 hours per week. Every prompt here uses the 2026 RCTF structure — Role, Context, Task, Format — for maximum depth and accuracy.
        </p>
        <div class="flex flex-wrap gap-3 text-sm text-blue-200">
          <span class="flex items-center gap-1.5"><Icon name="Check" size={14} /> 25 mega-prompts</span>
          <span class="flex items-center gap-1.5"><Icon name="Check" size={14} /> Pre-K through Administrators</span>
          <span class="flex items-center gap-1.5"><Icon name="Check" size={14} /> Works with ChatGPT, Claude, Gemini</span>
          <span class="flex items-center gap-1.5"><Icon name="Check" size={14} /> Copy with one click</span>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 bg-blue-50 border-b border-blue-100">
    <div class="container">
      <div class="flex items-start gap-3">
        <Icon name="Info" size={20} class="text-blue-600 shrink-0 mt-0.5" />
        <div>
          <p class="text-sm font-semibold text-blue-800 mb-1">How to use these mega-prompts</p>
          <p class="text-sm text-blue-700 leading-relaxed">
            Each prompt uses the <strong>RCTF framework</strong> (Role → Context → Task → Format) — the 2026 standard for getting deep, accurate, classroom-ready AI outputs. Copy any prompt, paste it into ChatGPT, Claude, or Gemini, then fill in the <code class="bg-blue-100 px-1 rounded text-xs">[BRACKETED FIELDS]</code> with your specific details. The more specific you are, the better the output.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div data-directory>
    <section class="py-5 bg-white border-b border-gray-100 sticky top-16 z-30 shadow-sm">
      <div class="container">
        <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center mb-2">
          <div class="relative flex-1 max-w-xs">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"><Icon name="Search" size={14} /></span>
            <label class="sr-only" for="prompt-search">Search prompts</label>
            <input id="prompt-search" data-search type="search" placeholder="Search prompts…" class="w-full pl-9 pr-4 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-200" />
          </div>
          <div class="flex flex-wrap gap-2">
            {
              gradeFilters.map((filter, index) => (
                <button type="button" data-filter-group="grade" data-tone="blue" data-value={filter} aria-pressed={index === 0 ? "true" : "false"} class="text-xs font-semibold font-display px-3 py-1.5 rounded-full border transition-colors bg-white text-gray-600 border-gray-200 hover:border-[#2563EB] hover:text-[#2563EB]">
                  {filter}
                </button>
              ))
            }
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          {
            subjectFilters.map((filter, index) => (
              <button type="button" data-filter-group="subject" data-tone="teal" data-value={filter} aria-pressed={index === 0 ? "true" : "false"} class="text-xs font-semibold font-display px-3 py-1.5 rounded-full border transition-colors bg-white text-gray-500 border-gray-200 hover:border-[#0D9488] hover:text-[#0D9488]">
                {filter}
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <section class="py-12 bg-[#F8FAFC]">
      <div class="container">
        <div class="flex items-center justify-between mb-6">
          <p class="text-sm text-gray-500 font-display">
            Showing <strong class="text-[#0F2A4A]" data-count>{prompts.length}</strong> of {prompts.length} prompts
          </p>
          <p class="text-xs text-gray-400">New prompts added monthly via Office Hours /AI</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {
            prompts.map((prompt) => (
              <article
                class="bg-white rounded-xl border border-gray-100 p-5 shadow-sm hover:shadow-md transition-all flex flex-col"
                data-item
                data-grade={prompt.grade}
                data-subject={prompt.subject}
                data-text={`${prompt.title} ${prompt.desc} ${prompt.tag}`}
              >
                <div class="flex items-center gap-2 flex-wrap mb-1.5">
                  <span class="text-xs font-bold font-display px-2 py-0.5 rounded-full" style={`background-color: ${prompt.tagBg}; color: ${prompt.tagColor}`}>{prompt.tag}</span>
                  <span class="text-xs text-gray-400 font-display font-semibold">{prompt.grade}</span>
                  <span class="text-xs text-gray-300">·</span>
                  <span class="text-xs text-gray-400">{prompt.subject}</span>
                  {prompt.timesSaved && (
                    <>
                      <span class="text-xs text-gray-300">·</span>
                      <span class="text-xs text-emerald-600 font-semibold">Saves {prompt.timesSaved}</span>
                    </>
                  )}
                </div>
                <h2 class="text-sm font-bold font-display text-[#0F2A4A] leading-snug mb-2">{prompt.title}</h2>
                <p class="text-xs text-gray-500 leading-relaxed mb-3">{prompt.desc}</p>
                <details class="mb-3">
                  <summary class="prompt-summary flex items-center gap-1 text-xs text-[#2563EB] font-semibold mb-2 cursor-pointer">
                    <Icon name="BookOpen" size={12} />
                    Preview prompt
                  </summary>
                  <div class="bg-[#F8FAFC] rounded-lg p-3 border border-gray-100 max-h-48 overflow-y-auto">
                    <pre data-copy-source class="text-xs text-gray-600 whitespace-pre-wrap font-mono leading-relaxed">{prompt.prompt}</pre>
                  </div>
                </details>
                <div class="mt-auto">
                  <button type="button" data-copy-target data-copied-label="Copied to clipboard!" class="w-full flex items-center justify-center gap-1.5 text-xs font-semibold font-display px-3 py-2 rounded-lg border bg-[#2563EB] text-white border-[#2563EB] hover:bg-blue-700">
                    <Icon name="Copy" size={12} />
                    <span data-copy-label-text>Copy Mega-Prompt</span>
                  </button>
                  <p data-copy-status class="text-xs text-red-600 mt-2" role="status"></p>
                </div>
              </article>
            ))
          }
        </div>
        <div data-empty hidden class="text-center py-16">
          <p class="text-gray-400 font-display mb-2">No prompts match your filters.</p>
          <button type="button" data-clear class="text-sm text-[#2563EB] hover:underline">Clear all filters</button>
        </div>
      </div>
    </section>
  </div>

  <section class="py-12 bg-[#0F2A4A]">
    <div class="container">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h2 class="text-xl font-bold font-display text-white mb-1">New prompts added every Sunday.</h2>
          <p class="text-sm text-blue-200">Subscribe to Office Hours /AI — one prompt, one tool, one story. Free.</p>
        </div>
        <a href="/newsletter" class="shrink-0 flex items-center gap-2 bg-[#E8533A] hover:bg-[#d4432a] text-white font-semibold font-display px-6 py-3 rounded-lg text-sm transition-colors">
          Subscribe Free <Icon name="ArrowRight" size={14} />
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  import "../scripts/directory.ts";
</script>
