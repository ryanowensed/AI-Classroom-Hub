---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { templates } from "../data/policies";
import type { icons } from "lucide";

const categories = ["All", ...Array.from(new Set(templates.map((template) => template.category)))];
const audiences = ["All", ...Array.from(new Set(templates.map((template) => template.audience)))];
const criticalCount = templates.filter((template) => template.urgency === "Critical").length;

const categoryColors: Record<string, string> = {
  "Acceptable Use": "bg-red-100 text-red-800",
  "Staff Guidelines": "bg-teal-100 text-teal-800",
  Governance: "bg-indigo-100 text-indigo-800",
  "Academic Integrity": "bg-amber-100 text-amber-800",
  "Data Privacy": "bg-purple-100 text-purple-800",
  "Family Communication": "bg-green-100 text-green-800",
  "Professional Development": "bg-orange-100 text-orange-800",
};

const urgencyClass = {
  Critical: "text-red-600 bg-red-50 border-red-200",
  High: "text-amber-600 bg-amber-50 border-amber-200",
  Standard: "text-blue-600 bg-blue-50 border-blue-200",
};

const urgencyIcon = {
  Critical: "AlertTriangle",
  High: "Shield",
  Standard: "CheckCircle",
} as const;

const audienceIcon: Record<string, keyof typeof icons> = {
  Students: "GraduationCap",
  Teachers: "BookOpen",
  Administrators: "Users",
  "All Staff": "Users",
  Families: "Users",
};

const accent = {
  Critical: "bg-[#E8533A]",
  High: "bg-amber-500",
  Standard: "bg-blue-500",
};
---

<Base
  title="AI Policy Templates — AI Classroom Hub"
  description="Customizable AI policy templates for schools and districts. Student acceptable use, teacher guidelines, governance, academic integrity, data privacy, and family communication."
  path="/policy-templates"
>
  <section class="py-16 bg-[#E8533A] relative overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: repeating-linear-gradient(45deg, white 0, white 1px, transparent 0, transparent 50%); background-size: 20px 20px;"></div>
    <div class="container relative">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-widest text-white/70 mb-3 font-display">POLICY TEMPLATE LIBRARY</p>
        <h1 class="font-display font-bold text-4xl md:text-5xl text-white leading-tight mb-4">AI policies your school can actually use.</h1>
        <p class="text-lg text-white/85 leading-relaxed mb-6">
          Only 6% of teachers say their school's AI policy is clear. These templates — based on the NYC DOE, California, and CoSN 2026 frameworks — give you a real starting point in minutes, not months.
        </p>
        <div class="flex flex-wrap gap-4 text-sm text-white/80">
          <span class="flex items-center gap-1.5"><Icon name="CheckCircle" size={16} class="text-white" /> {templates.length} templates</span>
          <span class="flex items-center gap-1.5"><Icon name="Shield" size={16} class="text-white" /> {criticalCount} marked Critical</span>
          <span class="flex items-center gap-1.5"><Icon name="Scale" size={16} class="text-white" /> FERPA &amp; COPPA aligned</span>
          <span class="flex items-center gap-1.5"><Icon name="FileText" size={16} class="text-white" /> Updated April 2026</span>
        </div>
      </div>
    </div>
  </section>

  <section data-locked-banner class="py-5 bg-[#0F2A4A] border-b border-blue-900">
    <div class="container flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <Icon name="Lock" size={20} class="text-blue-300 shrink-0" />
        <p class="text-sm text-blue-100">
          <span class="font-semibold text-white">Free access</span> — enter your name and email to copy or download any template.
        </p>
      </div>
      <button type="button" data-open-gate class="shrink-0 bg-[#E8533A] text-white text-sm font-semibold px-5 py-2 rounded-lg hover:bg-[#d44530] transition-colors">
        Unlock All Templates →
      </button>
    </div>
  </section>

  <section data-unlocked-banner class="py-3 bg-green-50 border-b border-green-200">
    <div class="container flex items-center gap-2">
      <Icon name="Unlock" size={16} class="text-green-600 shrink-0" />
      <p class="text-sm text-green-800 font-medium">Templates unlocked — copy or download any template below.</p>
    </div>
  </section>

  <section class="py-8 bg-amber-50 border-b border-amber-100">
    <div class="container">
      <div class="flex items-start gap-3">
        <Icon name="AlertTriangle" size={20} class="text-amber-600 shrink-0 mt-0.5" />
        <div>
          <p class="text-sm font-semibold text-amber-800 mb-1">How to use these templates</p>
          <p class="text-sm text-amber-700 leading-relaxed">
            Every template contains bracketed fields like <code class="bg-amber-100 px-1 rounded text-xs">[SCHOOL NAME]</code> and <code class="bg-amber-100 px-1 rounded text-xs">[DATE]</code> that you customize for your context. These are starting points — not final documents. Review with your legal counsel, union representatives, and school board before adoption.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div data-directory data-policy-library>
    <section class="py-6 bg-white border-b border-gray-100 sticky top-16 z-10 shadow-sm">
      <div class="container">
        <div class="flex flex-wrap gap-4 items-center">
          <div class="flex flex-wrap gap-2 items-center">
            <span class="text-xs font-bold text-gray-500 uppercase tracking-wide">Category:</span>
            {
              categories.map((category, index) => (
                <button type="button" data-filter-group="category" data-tone="coral" data-value={category} aria-pressed={index === 0 ? "true" : "false"} class="px-3 py-1.5 rounded-full text-xs font-semibold transition-all bg-gray-100 text-gray-600 hover:bg-gray-200">
                  {category}
                </button>
              ))
            }
          </div>
          <div class="flex flex-wrap gap-2 items-center">
            <span class="text-xs font-bold text-gray-500 uppercase tracking-wide">Audience:</span>
            {
              audiences.map((audience, index) => (
                <button type="button" data-filter-group="audience" data-tone="navy" data-value={audience} aria-pressed={index === 0 ? "true" : "false"} class="px-3 py-1.5 rounded-full text-xs font-semibold transition-all bg-gray-100 text-gray-600 hover:bg-gray-200">
                  {audience}
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="py-12 bg-gray-50">
      <div class="container">
        <div class="flex items-center justify-between mb-6">
          <p class="text-sm text-gray-500">Showing <span class="font-semibold text-gray-800" data-count>{templates.length}</span> templates</p>
          <p class="text-xs text-gray-400">All templates updated April 2026 · More added monthly</p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {
            templates.map((policy) => (
              <article
                class="policy-card bg-white border border-gray-200 rounded-xl overflow-hidden hover:shadow-md transition-shadow"
                data-item
                data-policy-id={policy.id}
                data-category={policy.category}
                data-audience={policy.audience}
                data-text={`${policy.title} ${policy.description}`}
              >
                <div class:list={["h-1 w-full", accent[policy.urgency]]}></div>
                <div class="p-6">
                  <div class="flex items-start justify-between gap-4 mb-3">
                    <div class="flex-1">
                      <div class="flex flex-wrap items-center gap-2 mb-2">
                        <span class:list={["inline-flex items-center gap-1 text-xs font-semibold px-2 py-0.5 rounded-full border", urgencyClass[policy.urgency]]}>
                          <Icon name={urgencyIcon[policy.urgency]} size={12} />
                          {policy.urgency}
                        </span>
                        <span class:list={["inline-flex items-center gap-1 text-xs font-medium px-2 py-0.5 rounded-full", categoryColors[policy.category] || "bg-gray-100 text-gray-700"]}>
                          {policy.category}
                        </span>
                        <span class="inline-flex items-center gap-1 text-xs text-gray-500">
                          <Icon name={audienceIcon[policy.audience] || "Users"} size={16} />
                          {policy.audience}
                        </span>
                      </div>
                      <h2 class="font-display font-bold text-[#0F2A4A] text-lg leading-snug">{policy.title}</h2>
                    </div>
                    <span data-locked><Icon name="Lock" size={16} class="text-gray-400 shrink-0 mt-1" /></span>
                    <span data-unlocked><Icon name="Unlock" size={16} class="text-green-500 shrink-0 mt-1" /></span>
                  </div>
                  <p class="text-sm text-gray-600 leading-relaxed mb-3">{policy.description}</p>
                  <div class="text-xs text-gray-400 mb-4">
                    <span class="font-medium text-gray-500">Updated:</span> {policy.lastUpdated} · <span class="font-medium text-gray-500">Based on:</span> {policy.basedOn}
                  </div>
                  <div class="mb-4">
                    <button type="button" data-unlocked data-expand class="text-sm font-medium text-[#2563EB] hover:text-blue-800 transition-colors">
                      Preview template
                    </button>
                    <div class="mt-3 relative">
                      <pre data-policy-text data-policy-preview hidden class="text-xs text-gray-700 whitespace-pre-wrap font-mono leading-relaxed bg-gray-50 border border-gray-200 rounded-lg p-4 max-h-64 overflow-y-auto">{policy.template}</pre>
                      <div data-locked class="bg-gray-50 border border-gray-200 rounded-lg p-4 max-h-32 overflow-hidden relative">
                        <pre class="text-xs text-gray-700 whitespace-pre-wrap font-mono leading-relaxed blur-sm select-none">{policy.template.slice(0, 300)}</pre>
                        <div class="absolute inset-0 flex items-center justify-center bg-white/60 rounded-lg">
                          <button type="button" data-open-gate class="flex items-center gap-2 bg-[#E8533A] text-white text-xs font-semibold px-3 py-1.5 rounded-lg hover:bg-[#d44530] shadow-sm">
                            <Icon name="Lock" size={12} />
                            Unlock to preview
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="flex gap-2">
                    <button type="button" data-policy-copy class="flex-1 flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold bg-gray-100 text-gray-700 hover:bg-gray-200">
                      <Icon name="Copy" size={16} />
                      <span data-label>Unlock to Copy</span>
                    </button>
                    <button type="button" data-policy-download class="flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold border border-gray-200 text-gray-700 hover:bg-gray-50">
                      <Icon name="Download" size={16} />
                      Download
                    </button>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
        <div data-empty hidden class="text-center py-16 text-gray-400">
          <p class="font-medium">No templates match those filters.</p>
          <button type="button" data-clear class="mt-2 text-sm text-[#2563EB] hover:underline">Clear filters</button>
        </div>
      </div>
    </section>
  </div>

  <section class="py-14 bg-[#0F2A4A]">
    <div class="container text-center">
      <p class="text-xs font-bold uppercase tracking-widest text-blue-300 mb-3 font-display">STAY CURRENT</p>
      <h2 class="font-display font-bold text-3xl text-white mb-4">New templates added monthly.</h2>
      <p class="text-blue-200 mb-6 max-w-xl mx-auto">
        AI policy is evolving faster than any district can track alone. Subscribe to Office Hours /AI and get policy updates, new templates, and governance guidance every Sunday.
      </p>
      <a href="/newsletter" class="inline-flex items-center gap-2 bg-[#E8533A] text-white font-semibold px-6 py-3 rounded-lg hover:bg-[#d44530] transition-colors">
        Subscribe Free →
      </a>
    </div>
  </section>

  <dialog data-policy-dialog class="rounded-xl p-0 max-w-md w-[calc(100%-2rem)] backdrop:bg-black/40">
    <div class="p-6">
      <div data-gate-form>
        <div class="flex items-center gap-3 mb-1">
          <div class="w-10 h-10 rounded-lg bg-[#E8533A]/10 flex items-center justify-center">
            <Icon name="Mail" size={20} class="text-[#E8533A]" />
          </div>
          <h2 class="font-display text-[#0F2A4A] text-xl">Access the Policy Library</h2>
        </div>
        <p class="text-gray-600 leading-relaxed text-sm mb-4">
          <span data-gate-specific hidden>
            You're one step away from <span class="font-semibold text-[#0F2A4A]" data-template-title></span>. Enter your name and email for free access to all 6 templates.
          </span>
          <span data-gate-generic>Get free access to all 6 AI policy templates — ready to customize for your school or district.</span>
        </p>
        <form data-policy-form data-subscribe-custom class="space-y-4" method="post" action="/api/subscribe">
          <input type="hidden" name="source" value="policy-templates" />
          <div class="hp" aria-hidden="true">
            <label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
          </div>
          <div>
            <label class="text-sm font-medium text-gray-700 mb-1 block" for="policy-first-name">First Name</label>
            <input id="policy-first-name" name="firstName" autocomplete="given-name" placeholder="e.g. Sarah" class="w-full px-3 py-2 rounded-lg border border-gray-200 text-sm" />
            <p data-error-name class="text-xs text-red-500 mt-1"></p>
          </div>
          <div>
            <label class="text-sm font-medium text-gray-700 mb-1 block" for="policy-email">Work Email</label>
            <input id="policy-email" name="email" type="email" autocomplete="email" placeholder="you@school.edu" class="w-full px-3 py-2 rounded-lg border border-gray-200 text-sm" />
            <p data-error-email class="text-xs text-red-500 mt-1"></p>
          </div>
          <p class="text-xs text-gray-400 leading-relaxed">
            By unlocking, you'll also receive occasional updates from the AI Classroom Hub when new templates are added. Unsubscribe anytime.
          </p>
          <p data-gate-status class="text-sm text-red-600" role="status"></p>
          <div class="flex gap-3 pt-1">
            <button type="submit" class="flex-1 bg-[#E8533A] hover:bg-[#d44530] text-white font-semibold px-4 py-2 rounded-lg">Unlock Free Access →</button>
            <button type="button" data-close-gate class="border border-gray-200 px-4 py-2 rounded-lg text-sm font-semibold">Cancel</button>
          </div>
        </form>
      </div>
      <div data-gate-confirmed hidden class="text-center py-2">
        <div class="w-14 h-14 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-4">
          <Icon name="CheckCircle" size={28} class="text-green-600" />
        </div>
        <h2 class="font-display text-[#0F2A4A] text-xl mb-2">You're in, <span data-confirmed-name></span>!</h2>
        <p class="text-gray-600 text-sm leading-relaxed mb-1">All 6 policy templates are now unlocked for this session.</p>
        <div data-gate-specific hidden class="mt-5 mb-5 text-left bg-gray-50 border border-gray-200 rounded-xl p-4">
          <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-1">Your requested template</p>
          <p class="font-semibold text-[#0F2A4A] text-sm mb-3 leading-snug" data-template-title></p>
          <div class="flex gap-2">
            <button type="button" data-confirm-download class="flex-1 inline-flex items-center justify-center gap-1.5 bg-[#2563EB] hover:bg-blue-700 text-white text-sm font-semibold px-3 py-2 rounded-lg">
              <Icon name="Download" size={16} />
              <span data-label>Download .txt</span>
            </button>
            <button type="button" data-confirm-copy class="flex-1 inline-flex items-center justify-center gap-1.5 border border-gray-200 text-sm font-semibold px-3 py-2 rounded-lg">
              <Icon name="Copy" size={16} />
              <span data-label>Copy Text</span>
            </button>
          </div>
        </div>
        <button type="button" data-close-gate class="text-sm text-[#2563EB] hover:text-blue-800 hover:underline font-medium">View all 6 templates →</button>
      </div>
    </div>
  </dialog>
</Base>

<script>
  import "../scripts/directory.ts";
  import "../scripts/policy.ts";
</script>
