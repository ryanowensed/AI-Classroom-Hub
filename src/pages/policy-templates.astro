---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { templates } from "../data/policies";
import type { icons } from "lucide";

const categories = ["All", ...Array.from(new Set(templates.map((template) => template.category)))];
const audiences = ["All", ...Array.from(new Set(templates.map((template) => template.audience)))];
const criticalCount = templates.filter((template) => template.urgency === "Critical").length;

const categoryColors: Record<string, string> = {
  "Acceptable Use": "bg-red-100 text-red-800",
  "Staff Guidelines": "bg-teal-100 text-teal-800",
  Governance: "bg-indigo-100 text-indigo-800",
  "Academic Integrity": "bg-amber-100 text-amber-800",
  "Data Privacy": "bg-purple-100 text-purple-800",
  "Family Communication": "bg-green-100 text-green-800",
  "Professional Development": "bg-orange-100 text-orange-800",
};

const urgencyClass = {
  Critical: "text-red-600 bg-red-50 border-red-200",
  High: "text-amber-600 bg-amber-50 border-amber-200",
  Standard: "text-blue-600 bg-blue-50 border-blue-200",
};

const urgencyIcon = {
  Critical: "AlertTriangle",
  High: "Shield",
  Standard: "CheckCircle",
} as const;

const audienceIcon: Record<string, keyof typeof icons> = {
  Students: "GraduationCap",
  Teachers: "BookOpen",
  Administrators: "Users",
  "All Staff": "Users",
  Families: "Users",
};

const accent = {
  Critical: "bg-[#E8533A]",
  High: "bg-amber-500",
  Standard: "bg-blue-500",
};
---

<Base
  title="AI Policy Templates — AI Classroom Hub"
  description="Customizable AI policy templates for schools and districts. Student acceptable use, teacher guidelines, governance, academic integrity, data privacy, and family communication."
  path="/policy-templates"
>
  <section class="py-16 bg-[#E8533A] relative overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: repeating-linear-gradient(45deg, white 0, white 1px, transparent 0, transparent 50%); background-size: 20px 20px;"></div>
    <div class="container relative">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-widest text-white/70 mb-3 font-display">POLICY TEMPLATE LIBRARY</p>
        <h1 class="font-display font-bold text-4xl md:text-5xl text-white leading-tight mb-4">AI policies your school can actually use.</h1>
        <p class="text-lg text-white/85 leading-relaxed mb-6">
          Only 6% of teachers say their school's AI policy is clear. These templates — based on the NYC DOE, California, and CoSN 2026 frameworks — give you a real starting point in minutes, not months.
        </p>
        <div class="flex flex-wrap gap-4 text-sm text-white/80">
          <span class="flex items-center gap-1.5"><Icon name="CheckCircle" size={16} class="text-white" /> {templates.length} templates</span>
          <span class="flex items-center gap-1.5"><Icon name="Shield" size={16} class="text-white" /> {criticalCount} marked Critical</span>
          <span class="flex items-center gap-1.5"><Icon name="Scale" size={16} class="text-white" /> FERPA &amp; COPPA aligned</span>
          <span class="flex items-center gap-1.5"><Icon name="FileText" size={16} class="text-white" /> Updated April 2026</span>
        </div>
      </div>
    </div>
  </section>

  <section class="py-8 bg-amber-50 border-b border-amber-100">
    <div class="container">
      <div class="flex items-start gap-3">
        <Icon name="AlertTriangle" size={20} class="text-amber-600 shrink-0 mt-0.5" />
        <div>
          <p class="text-sm font-semibold text-amber-800 mb-1">How to use these templates</p>
          <p class="text-sm text-amber-700 leading-relaxed">
            Every template contains bracketed fields like <code class="bg-amber-100 px-1 rounded text-xs">[SCHOOL NAME]</code> and <code class="bg-amber-100 px-1 rounded text-xs">[DATE]</code> that you customize for your context. These are starting points — not final documents. Review with your legal counsel, union representatives, and school board before adoption.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div data-directory data-policy-library>
    <section class="py-6 bg-white border-b border-gray-100 sticky top-16 z-10 shadow-sm">
      <div class="container">
        <div class="flex flex-wrap gap-4 items-center">
          <div class="flex flex-wrap gap-2 items-center">
            <span class="text-xs font-bold text-gray-500 uppercase tracking-wide">Category:</span>
            {
              categories.map((category, index) => (
                <button type="button" data-filter-group="category" data-tone="coral" data-value={category} aria-pressed={index === 0 ? "true" : "false"} class="px-3 py-1.5 rounded-full text-xs font-semibold transition-all bg-gray-100 text-gray-600 hover:bg-gray-200">
                  {category}
                </button>
              ))
            }
          </div>
          <div class="flex flex-wrap gap-2 items-center">
            <span class="text-xs font-bold text-gray-500 uppercase tracking-wide">Audience:</span>
            {
              audiences.map((audience, index) => (
                <button type="button" data-filter-group="audience" data-tone="navy" data-value={audience} aria-pressed={index === 0 ? "true" : "false"} class="px-3 py-1.5 rounded-full text-xs font-semibold transition-all bg-gray-100 text-gray-600 hover:bg-gray-200">
                  {audience}
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="py-12 bg-gray-50">
      <div class="container">
        <div class="flex items-center justify-between mb-6">
          <p class="text-sm text-gray-500">Showing <span class="font-semibold text-gray-800" data-count>{templates.length}</span> templates</p>
          <p class="text-xs text-gray-400">All templates updated April 2026 · More added monthly</p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {
            templates.map((policy) => (
              <article
                class="policy-card bg-white border border-gray-200 rounded-xl overflow-hidden hover:shadow-md transition-shadow"
                data-item
                data-policy-id={policy.id}
                data-category={policy.category}
                data-audience={policy.audience}
                data-text={`${policy.title} ${policy.description}`}
              >
                <div class:list={["h-1 w-full", accent[policy.urgency]]}></div>
                <div class="p-6">
                  <div class="flex items-start justify-between gap-4 mb-3">
                    <div class="flex-1">
                      <div class="flex flex-wrap items-center gap-2 mb-2">
                        <span class:list={["inline-flex items-center gap-1 text-xs font-semibold px-2 py-0.5 rounded-full border", urgencyClass[policy.urgency]]}>
                          <Icon name={urgencyIcon[policy.urgency]} size={12} />
                          {policy.urgency}
                        </span>
                        <span class:list={["inline-flex items-center gap-1 text-xs font-medium px-2 py-0.5 rounded-full", categoryColors[policy.category] || "bg-gray-100 text-gray-700"]}>
                          {policy.category}
                        </span>
                        <span class="inline-flex items-center gap-1 text-xs text-gray-500">
                          <Icon name={audienceIcon[policy.audience] || "Users"} size={16} />
                          {policy.audience}
                        </span>
                      </div>
                      <h2 class="font-display font-bold text-[#0F2A4A] text-lg leading-snug">{policy.title}</h2>
                    </div>
                  </div>
                  <p class="text-sm text-gray-600 leading-relaxed mb-3">{policy.description}</p>
                  <div class="text-xs text-gray-400 mb-4">
                    <span class="font-medium text-gray-500">Updated:</span> {policy.lastUpdated} · <span class="font-medium text-gray-500">Based on:</span> {policy.basedOn}
                  </div>
                  <pre data-policy-text class="text-xs text-gray-700 whitespace-pre-wrap font-mono leading-relaxed bg-gray-50 border border-gray-200 rounded-lg p-4 max-h-64 overflow-y-auto mb-4">{policy.template}</pre>
                  <p data-copy-status class="text-xs text-red-600 mb-2" role="status"></p>
                  <div class="flex gap-2">
                    <button type="button" data-policy-copy class="flex-1 flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold bg-[#E8533A] text-white hover:bg-[#d44530]">
                      <Icon name="Copy" size={16} />
                      <span data-label>Copy</span>
                    </button>
                    <button type="button" data-policy-download class="flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold border border-gray-200 text-gray-700 hover:bg-gray-50">
                      <Icon name="Download" size={16} />
                      Download
                    </button>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
        <div data-empty hidden class="text-center py-16 text-gray-400">
          <p class="font-medium">No templates match those filters.</p>
          <button type="button" data-clear class="mt-2 text-sm text-[#2563EB] hover:underline">Clear filters</button>
        </div>
      </div>
    </section>
  </div>

  <section class="py-14 bg-[#0F2A4A]">
    <div class="container text-center">
      <p class="text-xs font-bold uppercase tracking-widest text-blue-300 mb-3 font-display">STAY CURRENT</p>
      <h2 class="font-display font-bold text-3xl text-white mb-4">New templates added monthly.</h2>
<p class="text-blue-200 max-w-xl mx-auto">
            AI policy is evolving faster than any district can track alone.
          </p>
        </div>
      </section>
    </Base>

    <script>
      import "../scripts/directory.ts";
      import "../scripts/policy.ts";
    </script>
