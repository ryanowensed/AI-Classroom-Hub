---
import Wordmark from "./Wordmark.astro";
import Icon from "./Icon.astro";
import { branches, hubResources } from "../data/site";
import type { icons } from "lucide";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const desktopLinks = hubResources.slice(0, 3);
---

<header data-site-header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm">
  <div class="container">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2 shrink-0" aria-current={path === "/" ? "page" : undefined}>
        <Wordmark variant="light" size="sm" showTagline={false} />
      </a>

      <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
        <button
          type="button"
          data-mega-button
          class="flex items-center gap-1 px-4 py-2 rounded-md text-sm font-medium font-display text-gray-700 hover:bg-gray-50 hover:text-blue-700"
          aria-expanded="false"
          aria-controls="grade-menu"
        >
          <Icon name="School" size={15} />
          Grade Levels
          <Icon name="ChevronDown" size={14} class="transition-transform" />
        </button>

        {
          desktopLinks.map((item) => (
            <a
              href={item.href}
              aria-current={path === item.href ? "page" : undefined}
              class="flex items-center gap-1.5 px-4 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-blue-700 transition-colors"
            >
              <Icon name={item.icon as keyof typeof icons} size={14} />
              {item.label}
            </a>
          ))
        }

        <a
          href="/newsletter"
          aria-current={path === "/newsletter" ? "page" : undefined}
          class="flex items-center gap-1.5 px-4 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-blue-700 transition-colors"
        >
          <Icon name="Newspaper" size={14} />
          Newsletter
        </a>
      </nav>

      <div class="hidden lg:flex items-center gap-3">
        <a href="/about" class="text-sm font-medium text-gray-600 hover:text-blue-700 transition-colors">About</a>
        <a
          href="/newsletter"
          class="flex items-center gap-1.5 bg-[#E8533A] hover:bg-[#d4432a] text-white text-sm font-semibold font-display px-4 py-2 rounded-md transition-colors"
        >
          Subscribe Free
          <Icon name="ArrowRight" size={14} />
        </a>
      </div>

      <button
        type="button"
        data-mobile-button
        class="lg:hidden p-2 rounded-md text-gray-700 hover:bg-gray-100 transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span data-icon-open><Icon name="Menu" size={22} /></span>
        <span data-icon-close class="hidden"><Icon name="X" size={22} /></span>
      </button>
    </div>
  </div>

  <div id="grade-menu" data-mega class="hidden absolute top-full left-0 right-0 bg-white border-b border-border shadow-xl z-50">
    <div class="container py-6">
      <div class="grid grid-cols-5 gap-4">
        {
          branches.map((branch) => (
            <a href={branch.href} class="group p-4 rounded-lg border-2 border-transparent hover:border-gray-100 hover:bg-gray-50 transition-all">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-xl">{branch.icon}</span>
                <span class="text-xs font-bold font-display uppercase tracking-wider" style={`color: ${branch.color}`}>
                  {branch.label}
                </span>
              </div>
              <p class="text-xs text-gray-500 mb-3 leading-relaxed">{branch.desc}</p>
              <div class="space-y-1">
                {branch.resources.map((resource) => (
                  <div class="flex items-center gap-1 text-xs text-gray-400">
                    <div class="w-1 h-1 rounded-full" style={`background-color: ${branch.color}`} />
                    {resource}
                  </div>
                ))}
              </div>
              <div class="mt-3 text-xs font-semibold font-display flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity" style={`color: ${branch.color}`}>
                Explore <Icon name="ArrowRight" size={11} />
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div id="mobile-menu" data-mobile class="hidden lg:hidden bg-white border-t border-border shadow-lg">
    <div class="container py-4 space-y-1">
      <p class="text-xs font-bold font-display uppercase tracking-widest text-gray-400 px-3 py-2">Grade Levels</p>
      {
        branches.map((branch) => (
          <a href={branch.href} class="flex items-center gap-3 px-3 py-2.5 rounded-md hover:bg-gray-50 transition-colors">
            <span class="text-lg">{branch.icon}</span>
            <div>
              <div class="text-sm font-semibold font-display text-gray-800">{branch.label}</div>
              <div class="text-xs text-gray-500">{branch.desc.slice(0, 45)}…</div>
            </div>
          </a>
        ))
      }
      <div class="border-t border-border my-2"></div>
      <p class="text-xs font-bold font-display uppercase tracking-widest text-gray-400 px-3 py-2">Resources</p>
      {
        hubResources.map((item) => (
          <a href={item.href} class="flex items-center gap-3 px-3 py-2.5 rounded-md hover:bg-gray-50 transition-colors">
            <Icon name={item.icon as keyof typeof icons} size={16} class="" />
            <span class="text-sm font-medium text-gray-700">{item.label}</span>
          </a>
        ))
      }
      <div class="pt-3">
        <a href="/newsletter" class="block w-full text-center bg-[#E8533A] hover:bg-[#d4432a] text-white text-sm font-semibold font-display px-4 py-3 rounded-md transition-colors">
          Subscribe to Office Hours /AI — Free
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector("[data-site-header]");
  if (header) {
    const megaBtn = header.querySelector("[data-mega-button]");
    const mega = header.querySelector("[data-mega]");
    const mobileBtn = header.querySelector("[data-mobile-button]");
    const mobile = header.querySelector("[data-mobile]");
    const iconOpen = header.querySelector("[data-icon-open]");
    const iconClose = header.querySelector("[data-icon-close]");
    const chevron = megaBtn?.querySelector("svg:last-of-type");

    const setMega = (open: boolean) => {
      mega?.classList.toggle("hidden", !open);
      mega?.classList.toggle("lg:block", open);
      megaBtn?.setAttribute("aria-expanded", open ? "true" : "false");
      megaBtn?.classList.toggle("bg-blue-50", open);
      megaBtn?.classList.toggle("text-blue-700", open);
      chevron?.classList.toggle("rotate-180", open);
    };

    const setMobile = (open: boolean) => {
      mobile?.classList.toggle("hidden", !open);
      mobileBtn?.setAttribute("aria-expanded", open ? "true" : "false");
      iconOpen?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
    };

    megaBtn?.addEventListener("click", () => {
      setMega(megaBtn.getAttribute("aria-expanded") !== "true");
    });
    mobileBtn?.addEventListener("click", () => {
      setMobile(mobileBtn.getAttribute("aria-expanded") !== "true");
    });
    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (mega && megaBtn && !mega.contains(target) && !megaBtn.contains(target)) setMega(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setMega(false);
        setMobile(false);
      }
    });
    header.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        setMega(false);
        setMobile(false);
      });
    });

    const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 10);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
