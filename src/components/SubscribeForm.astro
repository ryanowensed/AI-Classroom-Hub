---
interface Props {
  source?: "office-hours" | "general" | "policy-templates";
  placeholder?: string;
  buttonText?: string;
  showFirstName?: boolean;
  inputClass?: string;
  buttonClass?: string;
  class?: string;
  id?: string;
}

const {
  source = "office-hours",
  placeholder = "your@email.com",
  buttonText = "Subscribe Free",
  showFirstName = false,
  inputClass = "",
  buttonClass = "",
  class: className = "",
  id,
} = Astro.props;
---

<form
  id={id}
  class:list={["flex flex-col gap-2", className]}
  method="post"
  action="/api/subscribe"
  data-subscribe-form
  novalidate
>
  <input type="hidden" name="source" value={source} />
  <div class="hp" aria-hidden="true">
    <label>
      Company
      <input type="text" name="company" tabindex="-1" autocomplete="off" />
    </label>
  </div>
  {
    showFirstName && (
      <input
        type="text"
        name="firstName"
        placeholder="First name (optional)"
        autocomplete="given-name"
        class:list={[
          "px-4 py-2.5 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200",
          inputClass,
        ]}
      />
    )
  }
  <div class="flex gap-2">
    <input
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder={placeholder}
      class:list={[
        "flex-1 px-4 py-2.5 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200",
        inputClass,
      ]}
    />
    <button
      type="submit"
      class:list={[
        "flex items-center gap-1.5 px-4 py-2.5 rounded-lg text-sm font-semibold font-display transition-colors disabled:opacity-60",
        buttonClass,
      ]}
    >
      {buttonText}
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
    </button>
  </div>
  <p data-form-status class="text-sm font-medium min-h-5" role="status"></p>
</form>

<script>
  const emailOk = (value: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);

  document.querySelectorAll("form[data-subscribe-form]:not([data-subscribe-custom])").forEach((node) => {
    const form = node as HTMLFormElement;
    if (form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const status = form.querySelector("[data-form-status]");
      const button = form.querySelector("button[type='submit']") as HTMLButtonElement | null;
      const data = new FormData(form);
      const email = String(data.get("email") ?? "").trim();
      if (!emailOk(email)) {
        if (status) {
          status.textContent = "Please enter a valid email address.";
          status.className = "text-sm font-medium text-red-700 bg-white px-3 py-2 rounded-lg";
        }
        return;
      }

      if (button) button.disabled = true;
      if (status) status.textContent = "";

      try {
        const response = await fetch("/api/subscribe", {
          method: "POST",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify({
            email,
            firstName: String(data.get("firstName") ?? ""),
            source: String(data.get("source") ?? "office-hours"),
            company: String(data.get("company") ?? ""),
          }),
        });
        const body = (await response.json().catch(() => null)) as { ok?: boolean; message?: string } | null;
        if (response.ok && body?.ok) {
          form.innerHTML =
            '<div class="flex items-center gap-2 text-sm font-semibold font-display text-green-700 bg-white/95 px-4 py-3 rounded-lg">You\'re subscribed! Check your inbox.</div>';
          return;
        }
        if (status) {
          status.textContent = body?.message || "Something went wrong. Try again in a minute.";
          status.className = "text-sm font-medium text-red-700 bg-white px-3 py-2 rounded-lg";
        }
      } catch {
        if (status) {
          status.textContent = "Something went wrong. Try again in a minute.";
          status.className = "text-sm font-medium text-red-700 bg-white px-3 py-2 rounded-lg";
        }
      }
      if (button) button.disabled = false;
    });
  });
</script>
