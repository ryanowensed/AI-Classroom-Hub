---
import Wordmark from "./Wordmark.astro";
import { branches } from "../data/site";
---

<footer class="bg-[#0F2A4A] text-white">
  <div class="container py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <div class="md:col-span-1">
        <Wordmark variant="dark" size="md" showTagline={true} class="mb-4" />
        <p class="text-sm text-blue-200 leading-relaxed">
          The trusted compass for AI in K-12 education. Practical tools, vetted resources, and honest guidance for teachers and administrators.
        </p>
      </div>

      <div>
        <p class="text-xs font-bold font-display uppercase tracking-widest text-blue-300 mb-4">Grade Levels</p>
        <ul class="space-y-2">
          {
            branches.map((branch) => (
              <li>
                <a href={branch.href} class="text-sm text-blue-100 hover:text-white transition-colors">
                  {branch.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-xs font-bold font-display uppercase tracking-widest text-blue-300 mb-4">Resources</p>
        <ul class="space-y-2">
          <li><a href="/tool-directory" class="text-sm text-blue-100 hover:text-white transition-colors">AI Tool Directory</a></li>
          <li><a href="/prompt-library" class="text-sm text-blue-100 hover:text-white transition-colors">Prompt Library</a></li>
          <li><a href="/hub-resources" class="text-sm text-blue-100 hover:text-white transition-colors">Hub Resources</a></li>
          <li><a href="/about" class="text-sm text-blue-100 hover:text-white transition-colors">About</a></li>
        </ul>
      </div>

      <div>
        <p class="text-xs font-bold font-display uppercase tracking-widest text-blue-300 mb-4">Office Hours /AI</p>
        <p class="text-sm text-blue-200 mb-4">The Sunday read for teachers who teach with AI. Free every week.</p>
        <a href="/newsletter" class="text-sm text-blue-100 hover:text-white transition-colors">Office Hours /AI</a>
      </div>
    </div>

    <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-blue-300">© 2026 AI Classroom Hub. Written by Ryan Owens.</p>
      <p class="text-xs text-blue-400">20+ years in K-12 classrooms. No courses. No certifications. Just what works.</p>
    </div>
  </div>
</footer>
