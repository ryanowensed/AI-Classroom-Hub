---
import Icon from "./Icon.astro";
import type { BranchAction, BranchConfig } from "../data/branches";

interface Props {
  config: BranchConfig;
}

const { config } = Astro.props;
const primaryAction: BranchAction = config.primaryAction ?? { label: "Prompt Library", href: "/prompt-library" };
const secondaryAction: BranchAction = config.secondaryAction ?? { label: "AI Tool Directory", href: "/tool-directory" };
const footerHref = config.ctaHref ?? "/newsletter";
const soonMessage = "Resource coming soon — check back after our next content release.";
---

<section class="py-16 relative overflow-hidden" style={`background-color: ${config.bg}`}>
  <div
    class="absolute inset-0 opacity-5"
    style={`background-image: radial-gradient(circle at 80% 50%, ${config.color} 0%, transparent 60%)`}
  ></div>
  <div class="container relative z-10">
    <div class="max-w-3xl">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-4xl">{config.icon}</span>
        <div
          class="text-xs font-bold font-display uppercase tracking-widest px-3 py-1 rounded-full"
          style={`background-color: ${config.color}20; color: ${config.color}`}
        >
          {config.label}
        </div>
      </div>
      <h1 class="text-4xl lg:text-5xl font-extrabold font-display text-[#0F2A4A] mb-4 leading-tight">
        {config.tagline}
      </h1>
      <p class="text-lg text-gray-600 leading-relaxed mb-6 max-w-2xl">{config.description}</p>
      <div class="flex flex-wrap gap-3">
        <a
          href={primaryAction.href}
          class="flex items-center gap-2 text-white font-semibold font-display px-5 py-2.5 rounded-lg text-sm transition-colors"
          style={`background-color: ${config.color}`}
          target={primaryAction.external ? "_blank" : undefined}
          rel={primaryAction.external ? "noreferrer" : undefined}
        >
          {primaryAction.label} <Icon name="ArrowRight" size={14} />
        </a>
        <a
          href={secondaryAction.href}
          class="flex items-center gap-2 bg-white border border-gray-200 text-gray-700 font-semibold font-display px-5 py-2.5 rounded-lg text-sm hover:bg-gray-50 transition-colors"
          target={secondaryAction.external ? "_blank" : undefined}
          rel={secondaryAction.external ? "noreferrer" : undefined}
        >
          {secondaryAction.label} <Icon name="ExternalLink" size={13} />
        </a>
      </div>
    </div>
  </div>
</section>

<section class="py-12 bg-white border-b border-gray-100">
  <div class="container">
    <div class="flex flex-wrap items-center gap-3">
      <span class="text-xs font-bold font-display uppercase tracking-widest text-gray-400">Key Focus Areas:</span>
      {
        config.focusAreas.map((area) => (
          <span
            class="text-xs font-semibold font-display px-3 py-1.5 rounded-full border"
            style={`border-color: ${config.color}40; color: ${config.color}; background-color: ${config.bg}`}
          >
            {area}
          </span>
        ))
      }
    </div>
  </div>
</section>

<section class="py-14 bg-[#F8FAFC]">
  <div class="container">
    <div class="mb-8">
      <span class="text-xs font-bold font-display uppercase tracking-widest mb-2 block" style={`color: ${config.color}`}>
        Resources
      </span>
      <h2 class="text-2xl font-extrabold font-display text-[#0F2A4A]">What's available for {config.label}</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        config.resources.map((resource) => {
          const inner = (
            <>
              <div class="flex items-start gap-3 mb-3">
                <span class="text-2xl">{resource.icon}</span>
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1 flex-wrap">
                    <h3 class="text-sm font-bold font-display text-[#0F2A4A]">{resource.title}</h3>
                    <span
                      class="text-xs font-semibold font-display px-2 py-0.5 rounded-full"
                      style={`background-color: ${resource.tagBg}; color: ${resource.tagColor}`}
                    >
                      {resource.tag}
                    </span>
                  </div>
                  <p class="text-xs text-gray-500 leading-relaxed">{resource.desc}</p>
                </div>
              </div>
              <div class="flex items-center gap-1 text-xs font-semibold font-display opacity-0 group-hover:opacity-100 transition-opacity" style={`color: ${config.color}`}>
                {resource.actionLabel ?? "Access resource"} <Icon name="ArrowRight" size={11} />
              </div>
            </>
          );
          const cardClass =
            "bg-white rounded-xl border border-gray-100 p-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all group block text-left w-full";
          return resource.href ? (
            <a
              href={resource.href}
              class={cardClass}
              target={resource.external ? "_blank" : undefined}
              rel={resource.external ? "noreferrer" : undefined}
            >
              {inner}
            </a>
          ) : (
            <div class={cardClass}>
              <button type="button" data-soon class="w-full text-left">
                {inner}
              </button>
              <p hidden data-soon-note class="mt-3 text-xs text-gray-600">
                {soonMessage}
              </p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<section class="py-12 bg-white">
  <div class="container">
    <div class="max-w-3xl mx-auto">
      <div class="rounded-xl p-6 border-l-4" style={`background-color: ${config.bg}; border-left-color: ${config.color}`}>
        <div class="flex items-start gap-3">
          <div class="text-2xl font-extrabold font-display leading-none mt-1" style={`color: ${config.color}`}>
            {config.heroStat.value}
          </div>
          <div>
            <div class="text-sm font-bold font-display text-[#0F2A4A] mb-1">{config.heroStat.label}</div>
            <p class="text-sm text-gray-600 leading-relaxed">{config.researchNote}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-12 bg-[#0F2A4A]">
  <div class="container">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h2 class="text-xl font-bold font-display text-white mb-1">
          {config.ctaTitle ?? "Get the weekly AI classroom digest."}
        </h2>
        <p class="text-sm text-blue-200">
          {config.ctaDescription ?? "Office Hours /AI — one tip, one tool, one story. Every Sunday. Free."}
        </p>
      </div>
      <a
        href={footerHref}
        class="shrink-0 flex items-center gap-2 bg-[#E8533A] hover:bg-[#d4432a] text-white font-semibold font-display px-6 py-3 rounded-lg text-sm transition-colors"
        target={config.ctaExternal ? "_blank" : undefined}
        rel={config.ctaExternal ? "noreferrer" : undefined}
      >
        {config.ctaLabel} <Icon name="ArrowRight" size={14} />
      </a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("[data-soon]").forEach((button) => {
    button.addEventListener("click", () => {
      const note = button.parentElement?.querySelector("[data-soon-note]");
      if (note instanceof HTMLElement) note.hidden = false;
    });
  });
</script>
